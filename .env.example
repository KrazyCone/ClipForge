# ---------------------------------------------------------------------------
# ClipForge configuration
#
# In production these belong in Freebuff Sites -> Secrets (server side only).
# The agent variables belong in the GitHub repository secrets for the
# collector and renderer workflows. Never commit real values.
# ---------------------------------------------------------------------------

# --- app (Sites secrets) ---------------------------------------------------
# From https://dev.twitch.tv/console/apps (create an app, any category).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Shared secret for the machine endpoints (/api/ingest, /api/queue,
# /api/spikes/:id/analyze, /api/clips/upload). Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Optional: Cloudflare Workers AI for vision, Whisper and LLM captions.
# Free daily neuron allowance. Leave unset to use the local heuristic scorer.
CF_ACCOUNT_ID=
CF_AI_TOKEN=
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
STT_MODEL=@cf/openai/whisper-large-v3-turbo

# --- agent (GitHub Actions secrets) ---------------------------------------
CLIPFORGE_BASE_URL=https://your-site.freebuff.page

# Optional: connect as a real Twitch account instead of anonymous read-only IRC.
# TWITCH_BOT_LOGIN=
# TWITCH_BOT_TOKEN=

RUN_SECONDS=1500
MAX_CHANNELS=5
